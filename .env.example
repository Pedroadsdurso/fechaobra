# ---------------------------------------------------------------------------
# FechaObra — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (região São Paulo). O .env.local NÃO vai para o Git.
# ---------------------------------------------------------------------------

# URL do projeto — Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon / publishable). Pode ir para o navegador: ela é
# limitada pelas policies de RLS. É a única chave segura de expor.
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# ---------------------------------------------------------------------------
# ATENÇÃO — SERVICE ROLE KEY
# ---------------------------------------------------------------------------
# Esta chave IGNORA COMPLETAMENTE o RLS. Quem tiver ela lê, altera e apaga
# o banco inteiro de todos os usuários.
#
#   1. NUNCA coloque o prefixo NEXT_PUBLIC_ nela. Esse prefixo faz o Next.js
#      injetar o valor no bundle JavaScript enviado ao navegador — qualquer
#      pessoa abriria o DevTools e leria a chave em texto puro.
#   2. Só pode ser importada dentro de Route Handlers (app/**/route.ts) ou
#      Server Actions ('use server'). Nunca em Client Component, nunca em
#      arquivo que um Client Component importe.
#   3. Na Vercel, cadastre como variável de ambiente comum (não pública).
#
# Uso previsto: Fase 1, leitura do orçamento público por token_publico.
# Na Fase 0 ela não é usada por nenhum arquivo.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

# Referência do projeto (o subdomínio da URL acima, ex: abcdefghijklmnop).
# Usado só pelo `npm run tipos` para gerar src/lib/tipos-banco.ts.
SUPABASE_PROJECT_ID=SEU_PROJECT_ID_AQUI

# URL pública da aplicação — é daqui que sai o link que o prestador manda para
# o cliente dele. Em desenvolvimento pode ficar vazia (cai em localhost).
#
# EM PRODUÇÃO É OBRIGATÓRIA: o build falha sem ela. Um link de localhost
# chegando no WhatsApp de um cliente real não tem conserto depois.
# Na Vercel, VERCEL_PROJECT_PRODUCTION_URL serve como alternativa automática.
NEXT_PUBLIC_URL_BASE=

# ---------------------------------------------------------------------------
# CAKTO — SEGREDO DO WEBHOOK
# ---------------------------------------------------------------------------
# A Cakto NÃO assina o payload com HMAC e não manda header de assinatura: o
# segredo compartilhado viaja dentro do corpo JSON, no campo `secret`, e a
# validação é comparar os dois.
#
#   1. NUNCA com prefixo NEXT_PUBLIC_. Quem tiver este valor forja qualquer
#      evento de compra — inclusive liberar acesso vitalício de graça.
#   2. Só é lida em src/app/api/webhook/cakto/route.ts, que é Route Handler.
#   3. Como o segredo anda no corpo, o log do webhook remove o campo `secret`
#      antes de gravar. Não desfaça isso: seria a credencial em texto puro no
#      banco, exposta a backup e export.
#   4. Se vazar, gere outro na Cakto (Integrações > Webhooks) e troque aqui.
# ---------------------------------------------------------------------------
CAKTO_WEBHOOK_SECRET=
